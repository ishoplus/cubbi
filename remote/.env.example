# 對外連線（手機從外面連進來）：none／tailscale（推薦）／ngrok／external
#   tailscale：要先 tailscale up，並在管理頁打開 MagicDNS 與 HTTPS
#   ngrok：NGROK_AUTHTOKEN（https://dashboard.ngrok.com/get-started/your-authtoken），NGROK_DOMAIN 可指定固定網域
#   external：通道自己管（cloudflared 命名隧道等），網址寫在 CLAUDE_WEB_URL
#   不支援 trycloudflare 臨時隧道（不支援 SSE）
# TUNNEL=tailscale
# NGROK_AUTHTOKEN=your_ngrok_token_here

# 個人化設定檔（外掛、天氣、語言、專案制服、貓的名字…），預設 data/config.json；格式見 config.js
# CW_CONFIG=/path/to/config.json

# 允許操作的根目錄（預設為啟動時所在的資料夾）
# WORK_ROOT=/Users/yourname/projects

# 開放權限模式「全部放行」（bypassPermissions），預設關閉
# ALLOW_BYPASS=1

# 信箱驗證碼登入（遠端用），沒設就只能用 node scripts/login-link.mjs
# LOGIN_EMAIL=you@example.com
# LOGIN_EMAIL_FROM=claude-web <noreply@your-domain.com>
# 寄信二選一：Resend（RESEND_API_KEY）或 SMTP（設了 SMTP_HOST 就用；MAIL_PROVIDER 可以明指）
# RESEND_API_KEY=re_xxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=應用程式密碼
# 收件箱有新項目時推播（ntfy 的 topic 網址），設空字串就關
# PUSH_URL=https://ntfy.sh/your-secret-topic
# CLAUDE_WEB_URL=https://your-domain.com

# 只聽本機（預設 127.0.0.1），要讓區網直接連再設 0.0.0.0
# HOST=127.0.0.1

# 固定 Access Token（不設定則每次啟動自動產生）
# ACCESS_TOKEN=your_fixed_token_here

# 伺服器 port（預設 17000）
# PORT=17000

# 同時可存在的對話數上限（等人回答中的也算，預設 MAX_CONCURRENT * 4）
# MAX_SESSIONS=16

# 跑到一半沒動靜的逾時（毫秒，預設 30 分鐘）
# CLAUDE_TIMEOUT_MS=1800000

# 停下來等你回答授權／選項的逾時（毫秒，預設 2 小時）
# CLAUDE_ANSWER_TIMEOUT_MS=7200000

# 前端斷線後保留對話等重連的寬限（毫秒，預設 5 分鐘）
# CLAUDE_ORPHAN_GRACE_MS=300000

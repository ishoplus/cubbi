{
  "name": "cubbi",
  "version": "0.4.0-beta.2",
  "description": "Run a crew of coding agents on your computer: watch them in a 3D office, steer them from your phone",
  "type": "module",
  "main": "server/index.js",
  "bin": {
    "cubbi": "bin/cubbi.js"
  },
  "files": [
    "bin",
    "server",
    "web",
    "remote",
    "!remote/tests"
  ],
  "scripts": {
    "start": "node bin/cubbi.js",
    "test": "node --test",
    "vendor-three": "node scripts/vendor-three.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "ishoplus",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishoplus/cubbi.git"
  },
  "keywords": [
    "claude-code",
    "agents",
    "3d",
    "visualization",
    "threejs"
  ],
  "dependencies": {
    "archiver": "^8.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "nodemailer": "^10.2.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "three": "^0.186.1"
  },
  "optionalDependencies": {
    "@ngrok/ngrok": "^1.7.0"
  }
}
